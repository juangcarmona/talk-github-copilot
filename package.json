{
  "name": "talk-github-copilot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts && node scripts/routes.mjs && node scripts/verify-static.mjs",
    "preview": "wrangler pages dev dist --port 8788",
    "test": "node --test tests/*.test.mjs && playwright test"
  },
  "dependencies": {
    "@juangcarmona/lighthouse-ui": "0.2.0",
    "mermaid": "12.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "markdown-it": "15.0.3",
    "shiki": "4.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.154.0",
    "yaml": "2.9.1"
  }
}
